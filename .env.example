# Supabase project URL (Supabase Dashboard -> Project Settings -> API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only Supabase secret/service-role key. Never expose this to frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables Gemini-powered assistant and HSN suggestions.
GEMINI_API_KEY=
